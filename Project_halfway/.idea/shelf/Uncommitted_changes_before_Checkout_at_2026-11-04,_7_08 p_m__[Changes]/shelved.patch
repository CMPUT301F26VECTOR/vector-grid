 /**
  * Calendar on the campsite details screen showing the campsite's available dates.
+ * Matches the mockup design and highlights the date ranges set by the campsite owner.
  *
- * Outstanding issues: not built yet; it only prints a message for now.
- *
+ * @param availableDateRanges list of date range maps containing "start" and "end" date strings (YYYY-MM-DD)
  * @param modifier layout options from the screen that shows it
  */
 @Composable
-fun CampsiteCalendar( modifier: Modifier = Modifier) {
-    print("CALANDER TO BE IMPLEMENTED")
+fun CampsiteCalendar(
+    availableDateRanges: List<Map<String, String>> = emptyList(),
+    modifier: Modifier = Modifier
+) {
+    // Determine initial month and year from owner's first available date range (defaulting to Sep 2025)
+    val firstStartStr = availableDateRanges.firstOrNull()?.get("start")
+    val initialDate = remember(availableDateRanges) {
+        val parts = firstStartStr?.split("-")
+        val year = parts?.getOrNull(0)?.toIntOrNull() ?: 2025
+        val month = (parts?.getOrNull(1)?.toIntOrNull() ?: 9) - 1 // 0-indexed month
+        year to month
+    }
+
+    var currentYear by remember(initialDate) { mutableStateOf(initialDate.first) }
+    var currentMonth by remember(initialDate) { mutableStateOf(initialDate.second) }
+
+    val monthNames = listOf("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
+    val daysOfWeek = listOf("Su", "Mo", "Tu", "We", "Th", "Fr", "Sa")
+
+    Card(
+        modifier = modifier
+            .fillMaxWidth()
+            .padding(horizontal = 4.dp),
+        shape = RoundedCornerShape(20.dp),
+        colors = CardDefaults.cardColors(containerColor = Color.White),
+        border = BorderStroke(1.dp, Color(0xFFE0E0E0))
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(16.dp),
+            horizontalAlignment = Alignment.CenterHorizontally
+        ) {
+            // Header Row: <  [Sep v] [2025 v]  >
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.SpaceBetween,
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                IconButton(
+                    onClick = {
+                        if (currentMonth == 0) {
+                            currentMonth = 11
+                            currentYear--
+                        } else {
+                            currentMonth--
+                        }
+                    },
+                    modifier = Modifier.size(32.dp)
+                ) {
+                    Icon(
+                        imageVector = Icons.AutoMirrored.Filled.KeyboardArrowLeft,
+                        contentDescription = "Previous Month",
+                        tint = Color(0xFF424242)
+                    )
+                }
+
+                Row(
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                    verticalAlignment = Alignment.CenterVertically
+                ) {
+                    // Month Dropdown Pill
+                    Surface(
+                        shape = RoundedCornerShape(10.dp),
+                        border = BorderStroke(1.dp, Color(0xFFCCCCCC)),
+                        color = Color.White
+                    ) {
+                        Row(
+                            modifier = Modifier.padding(horizontal = 10.dp, vertical = 4.dp),
+                            verticalAlignment = Alignment.CenterVertically
+                        ) {
+                            Text(
+                                text = monthNames[currentMonth],
+                                fontSize = 14.sp,
+                                fontWeight = FontWeight.Medium,
+                                color = Color(0xFF212121)
+                            )
+                            Spacer(modifier = Modifier.width(4.dp))
+                            Icon(
+                                imageVector = Icons.Default.ArrowDropDown,
+                                contentDescription = null,
+                                modifier = Modifier.size(18.dp),
+                                tint = Color(0xFF666666)
+                            )
+                        }
+                    }
+
+                    // Year Dropdown Pill
+                    Surface(
+                        shape = RoundedCornerShape(10.dp),
+                        border = BorderStroke(1.dp, Color(0xFFCCCCCC)),
+                        color = Color.White
+                    ) {
+                        Row(
+                            modifier = Modifier.padding(horizontal = 10.dp, vertical = 4.dp),
+                            verticalAlignment = Alignment.CenterVertically
+                        ) {
+                            Text(
+                                text = currentYear.toString(),
+                                fontSize = 14.sp,
+                                fontWeight = FontWeight.Medium,
+                                color = Color(0xFF212121)
+                            )
+                            Spacer(modifier = Modifier.width(4.dp))
+                            Icon(
+                                imageVector = Icons.Default.ArrowDropDown,
+                                contentDescription = null,
+                                modifier = Modifier.size(18.dp),
+                                tint = Color(0xFF666666)
+                            )
+                        }
+                    }
+                }
+
+                IconButton(
+                    onClick = {
+                        if (currentMonth == 11) {
+                            currentMonth = 0
+                            currentYear++
+                        } else {
+                            currentMonth++
+                        }
+                    },
+                    modifier = Modifier.size(32.dp)
+                ) {
+                    Icon(
+                        imageVector = Icons.AutoMirrored.Filled.KeyboardArrowRight,
+                        contentDescription = "Next Month",
+                        tint = Color(0xFF424242)
+                    )
+                }
+            }
+
+            Spacer(modifier = Modifier.height(16.dp))
+
+            // Days of the Week Header Row
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.SpaceBetween
+            ) {
+                daysOfWeek.forEach { day ->
+                    Text(
+                        text = day,
+                        modifier = Modifier.weight(1f),
+                        textAlign = TextAlign.Center,
+                        fontSize = 13.sp,
+                        fontWeight = FontWeight.Normal,
+                        color = Color(0xFF757575)
+                    )
+                }
+            }
+
+            Spacer(modifier = Modifier.height(12.dp))
+
+            // Calendar grid math using java.util.Calendar
+            val calendar = remember(currentYear, currentMonth) {
+                java.util.Calendar.getInstance().apply {
+                    set(java.util.Calendar.YEAR, currentYear)
+                    set(java.util.Calendar.MONTH, currentMonth)
+                    set(java.util.Calendar.DAY_OF_MONTH, 1)
+                }
+            }
+            val daysInMonth = calendar.getActualMaximum(java.util.Calendar.DAY_OF_MONTH)
+            val startOffset = calendar.get(java.util.Calendar.DAY_OF_WEEK) - 1 // Sunday = 0
+
+            // Helper to check date status against owner's set availableDateRanges
+            fun checkDateStatus(day: Int): Triple<Boolean, Boolean, Boolean> {
+                val formattedMonth = String.format(Locale.getDefault(), "%02d", currentMonth + 1)
+                val formattedDay = String.format(Locale.getDefault(), "%02d", day)
+                val dateStr = "$currentYear-$formattedMonth-$formattedDay"
+
+                // Preview mockup fallback if list is empty
+                if (availableDateRanges.isEmpty() && currentYear == 2025 && currentMonth == 8) {
+                    val isStart = day == 9
+                    val isEnd = day == 13
+                    val isInRange = day in 10..12
+                    return Triple(isStart, isEnd, isInRange)
+                }
+
+                var isStart = false
+                var isEnd = false
+                var isInRange = false
+
+                for (range in availableDateRanges) {
+                    val start = range["start"] ?: ""
+                    val end = range["end"] ?: ""
+
+                    if (dateStr == start) isStart = true
+                    if (dateStr == end) isEnd = true
+                    if (dateStr > start && dateStr < end) isInRange = true
+                }
+                return Triple(isStart, isEnd, isInRange)
+            }
+
+            // Render 5 grid rows
+            Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                for (row in 0 until 5) {
+                    Row(
+                        modifier = Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.SpaceBetween
+                    ) {
+                        for (col in 0 until 7) {
+                            val cellIndex = row * 7 + col
+                            val dayNumber = cellIndex - startOffset + 1
+
+                            Box(
+                                modifier = Modifier
+                                    .weight(1f)
+                                    .height(36.dp),
+                                contentAlignment = Alignment.Center
+                            ) {
+                                if (dayNumber in 1..daysInMonth) {
+                                    val (isStart, isEnd, isInRange) = checkDateStatus(dayNumber)
+
+                                    val bgColor = when {
+                                        isStart || isEnd -> Color(0xFF333333)
+                                        isInRange -> Color(0xFFEEEEEE)
+                                        else -> Color.Transparent
+                                    }
+
+                                    val textColor = when {
+                                        isStart || isEnd -> Color.White
+                                        else -> Color(0xFF212121)
+                                    }
+
+                                    Box(
+                                        modifier = Modifier
+                                            .size(32.dp)
+                                            .background(bgColor, RoundedCornerShape(8.dp)),
+                                        contentAlignment = Alignment.Center
+                                    ) {
+                                        Text(
+                                            text = dayNumber.toString(),
+                                            fontSize = 14.sp,
+                                            fontWeight = if (isStart || isEnd) FontWeight.Bold else FontWeight.Normal,
+                                            color = textColor
+                                        )
+                                    }
+                                } else if (dayNumber > daysInMonth) {
+                                    // Trailing next month dates (light gray)
+                                    val nextMonthDay = dayNumber - daysInMonth
+                                    Text(
+                                        text = nextMonthDay.toString(),
+                                        fontSize = 14.sp,
+                                        color = Color(0xFFBDBDBD)
+                                    )
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
 }
